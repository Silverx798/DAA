#include <stdio.h>
#include <stdlib.h>

#define MAX_SUBSETS 1048576
#define MAX_ELEMENTS 20
int results[MAX_SUBSETS][MAX_ELEMENTS];
int result_sizes[MAX_SUBSETS];
int result_count = 0;

int elements[MAX_ELEMENTS];
int current_subset[MAX_ELEMENTS];
int n, target_sum;

void backtrack(int index, int current_sum, int subset_size) {
    if (current_sum == target_sum) {
        for (int i = 0; i < subset_size; i++) {
            results[result_count][i] = current_subset[i];
        }
        result_sizes[result_count] = subset_size;
        result_count++;
        return; 
    }
    if (index == n || current_sum > target_sum) {
        return;
    }

    current_subset[subset_size] = elements[index];
    backtrack(index + 1, current_sum + elements[index], subset_size + 1);
    backtrack(index + 1, current_sum, subset_size);
}
int main() {
    if (scanf("%d", &n) != 1) return 0;
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &elements[i]) != 1) return 0;
    }

    if (scanf("%d", &target_sum) != 1) return 0;
    backtrack(0, 0, 0);

    if (result_count == 0) {
        printf("-1\n");
    } else {
        for (int i = result_count - 1; i >= 0; i--) {
            for (int j = 0; j < result_sizes[i]; j++) {
                printf("%d ", results[i][j]);
            }
            printf("\n");
        }
    }
    return 0;
}

