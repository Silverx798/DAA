#include <stdio.h>
#include <stdlib.h>

#define INF 1000000000 

struct Edge {
    int u, v, w;
};

void printPath(int parent[], int j) {
    if (parent[j] == -1) {
        printf("%d", j);
        return;
    }
    printPath(parent, parent[j]);
    printf("->%d", j);
}

int main() {
    int V, E, src;

    if (scanf("%d", &V) != 1) return 0;
    if (scanf("%d", &E) != 1) return 0;

    struct Edge *edges = (struct Edge *)malloc(E * sizeof(struct Edge));
    for (int i = 0; i < E; i++) {
        scanf("%d %d %d", &edges[i].u, &edges[i].v, &edges[i].w);
    }

    scanf("%d", &src);

    long long *dist = (long long *)malloc((V + 1) * sizeof(long long));
    int *parent = (int *)malloc((V + 1) * sizeof(int));

    for (int i = 1; i <= V; i++) {
        dist[i] = INF;
        parent[i] = -1;
    }
    dist[src] = 0;

    for (int i = 1; i <= V - 1; i++) {
        for (int j = 0; j < E; j++) {
            int u = edges[j].u;
            int v = edges[j].v;
            long long w = edges[j].w;
            if (dist[u] != INF && dist[u] + w < dist[v]) {
                dist[v] = dist[u] + w;
                parent[v] = u;
            }
        }
    }
    int hasNegativeCycle = 0;
    for (int j = 0; j < E; j++) {
        int u = edges[j].u;
        int v = edges[j].v;
        long long w = edges[j].w;
        if (dist[u] != INF && dist[u] + w < dist[v]) {
            hasNegativeCycle = 1;
            break;
        }
    }
    if (hasNegativeCycle) {
        printf("Negative cycle detected\n");
    } else {
        for (int i = 1; i <= V; i++) {
            if (i == src) continue; 
            if (dist[i] >= INF / 2) {
                printf("%d INF None\n", i);
            } else {
                printf("%d %lld ", i, dist[i]);
                printPath(parent, i);
                printf("\n");
            }
        }
    }
    free(edges);
    free(dist);
    free(parent);
    return 0;
}
